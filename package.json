{
  "name": "golden-hamster-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "金丝熊饲养助手：本地优先、可云同步的金丝熊成长与健康记录 App",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "start:server": "npm --prefix server run start",
    "deploy:ghpages": "node scripts/deploy-gh-pages.mjs"
  }
}
